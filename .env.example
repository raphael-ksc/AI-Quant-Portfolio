# 複製為 .env 後填入實際值；.env 已被 .gitignore 排除
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=quant_portfolio
# 本機 MySQL80 用 3306；改用 Docker（docker compose up -d）時把 MYSQL_PORT 改成 3307
# Docker 專用：root 密碼（只在 docker-compose.yml 建立容器時使用）；Docker 的 MYSQL_USER 不能是 root
MYSQL_ROOT_PASSWORD=
MYSQL_DOCKER_PORT=3307
# 整合測試專用的資料庫名稱（例：quant_portfolio_test）；留空則略過整合測試，絕不會動到正式資料庫
MYSQL_TEST_DATABASE=
WUCAI_SQL_PASSWORD=
LLM_API_KEY=
